{
  "name": "zcamera-client",
  "version": "0.1.0",
  "description": "Simple local Electron client for ZCamera cameras",
  "license": "MIT",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.renderer.json && node scripts/copy-static.cjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "check:publish": "node scripts/check-publish-boundary.cjs",
    "prepare": "node scripts/install-git-hooks.cjs"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "electron": "^36.0.0",
    "typescript": "^5.7.2"
  }
}
