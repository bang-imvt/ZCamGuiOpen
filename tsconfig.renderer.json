{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "app/renderer",
    "rootDir": "src",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": ["src/renderer/renderer.ts", "src/shared/**/*.ts"]
}
